{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fiodor78/project-plato/main/schemas/provenance/provenance.schema.json",
  "title": "Thinker Framework Provenance Schema",
  "version": "0.2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thinker_id",
    "provenance_id",
    "subject_id",
    "created_at",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.1"
    },
    "thinker_id": {
      "type": "string",
      "pattern": "^TH\\.[A-Z0-9_]+$"
    },
    "provenance_id": {
      "type": "string",
      "pattern": "^TH\\.[A-Z0-9_]+\\.PROV\\.[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subject_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "enum": [
        "CUSTODIAN",
        "THINKER_RUNTIME",
        "INGEST_PIPELINE",
        "TEST_HARNESS"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_kind",
          "relation"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "CORPUS_SEGMENT",
              "TEXTUAL_WITNESS",
              "TRANSLATION",
              "ACQUIRED_MEMORY",
              "EPISODIC_MEMORY",
              "INFERENCE_MEMORY",
              "USER_UTTERANCE",
              "RETRIEVAL_EVENT",
              "CUSTODIAN_SOURCE",
              "EXPERIMENT_EVENT"
            ]
          },
          "relation": {
            "type": "string",
            "enum": [
              "DERIVED_FROM",
              "REPORTED_BY",
              "RETRIEVED_FROM",
              "QUOTED_FROM",
              "SUPPORTED_BY",
              "CONTRADICTED_BY",
              "OBSERVED_IN"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "retrieval_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "retrieval_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "STRUCTURAL",
            "SEMANTIC",
            "HYBRID",
            null
          ]
        },
        "query_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "index_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
