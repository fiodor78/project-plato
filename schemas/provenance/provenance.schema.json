{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fiodor78/project-plato/main/schemas/provenance/provenance.schema.json",
  "title": "PROJECT PLATO Provenance Schema",
  "description": "Auditable lineage connecting claims, memories, corpus passages, retrieval events and inferences.",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provenance_id", "subject_id", "created_at", "sources"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "provenance_id": {
      "type": "string",
      "pattern": "^PL\\.PROV\\.[A-Z0-9_-]+$"
    },
    "subject_id": {
      "type": "string",
      "description": "The object whose lineage is being asserted."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": {
      "type": "string",
      "enum": ["CUSTODIAN", "PLATO_RUNTIME", "INGEST_PIPELINE", "TEST_HARNESS"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_kind", "relation"],
        "properties": {
          "source_id": { "type": "string" },
          "source_kind": {
            "type": "string",
            "enum": [
              "CORPUS_SEGMENT",
              "TEXTUAL_WITNESS",
              "TRANSLATION",
              "ACQUIRED_MEMORY",
              "EPISODIC_MEMORY",
              "INFERENCE_MEMORY",
              "USER_UTTERANCE",
              "RETRIEVAL_EVENT",
              "CUSTODIAN_SOURCE",
              "EXPERIMENT_EVENT"
            ]
          },
          "relation": {
            "type": "string",
            "enum": [
              "DERIVED_FROM",
              "REPORTED_BY",
              "RETRIEVED_FROM",
              "QUOTED_FROM",
              "SUPPORTED_BY",
              "CONTRADICTED_BY",
              "OBSERVED_IN"
            ]
          },
          "role": { "type": ["string", "null"] },
          "excerpt_hash": { "type": ["string", "null"] }
        }
      }
    },
    "retrieval_context": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "retrieval_event_id": { "type": ["string", "null"] },
        "mode": {
          "type": ["string", "null"],
          "enum": ["STRUCTURAL", "SEMANTIC", "HYBRID", null]
        },
        "query_hash": { "type": ["string", "null"] },
        "index_version": { "type": ["string", "null"] }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
