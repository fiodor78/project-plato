{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fiodor78/project-plato/main/schemas/runtime/runtime-projection.schema.json",
  "title": "Thinker Runtime Projection Configuration",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "entity_rules"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "profile_id": { "type": "string", "pattern": "^TH\\.[A-Z0-9_]+$" },
    "entity_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required_visibility", "model_fields"],
        "properties": {
          "required_visibility": { "const": "THINKER_VISIBLE" },
          "model_fields": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
