{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fiodor78/project-plato/main/schemas/memory/memory.schema.json",
  "title": "Thinker Framework Mutable Memory Schema",
  "version": "0.2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thinker_id",
    "memory_id",
    "instance_id",
    "memory_type",
    "created_at",
    "content",
    "epistemic_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.1"
    },
    "thinker_id": {
      "type": "string",
      "pattern": "^TH\\.[A-Z0-9_]+$"
    },
    "memory_id": {
      "type": "string",
      "pattern": "^TH\\.[A-Z0-9_]+\\.MEM\\.[A-Z0-9._-]+\\.(ACQUIRED|EPISODIC|INFERENCE)\\.[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+-[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[A-Z0-9._-]+)?$"
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "ACQUIRED",
        "EPISODIC",
        "INFERENCE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "language"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "normalized_proposition": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "REPORTED",
        "TENTATIVELY_ACCEPTED",
        "ACCEPTED_FOR_REASONING",
        "DOUBTED",
        "CONTRADICTED",
        "INFERRED"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "source_actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "conversation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "provenance_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "supersedes_memory_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "RETRACTED"
      ],
      "default": "ACTIVE"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "memory_type": {
            "const": "INFERENCE"
          }
        },
        "required": [
          "memory_type"
        ]
      },
      "then": {
        "properties": {
          "epistemic_status": {
            "const": "INFERRED"
          }
        },
        "required": [
          "derived_from"
        ]
      }
    }
  ]
}
