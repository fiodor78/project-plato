{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fiodor78/project-plato/main/thinkers/plato/catalog/catalog.schema.json",
  "title": "Plato Historical Attribution Catalog",
  "version": "0.1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "thinker_id",
    "sources",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.4"
    },
    "catalog_version": {
      "type": "string"
    },
    "thinker_id": {
      "const": "TH.PLATO"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "citation",
          "url"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^PLSRC\\.[A-Z0-9_]+$"
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "ANCIENT_TESTIMONY",
              "CRITICAL_EDITION",
              "MODERN_SCHOLARSHIP",
              "CATALOG",
              "ANTHOLOGY"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalog_id",
          "entry_type",
          "canonical_title",
          "alternate_titles",
          "survival_status",
          "runtime_candidacy",
          "attestations",
          "review_status",
          "runtime_visibility",
          "scope_classes"
        ],
        "properties": {
          "catalog_id": {
            "type": "string",
            "pattern": "^TH\\.PLATO\\.CAT\\.[A-Z0-9_]+$"
          },
          "entry_type": {
            "type": "string",
            "enum": [
              "WORK",
              "COLLECTION",
              "MEMBER",
              "LOST_TITLE",
              "ANTHOLOGY_COLLECTION"
            ]
          },
          "canonical_title": {
            "type": "string",
            "minLength": 1
          },
          "alternate_titles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "provisional_work_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_catalog_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "survival_status": {
            "type": "string",
            "enum": [
              "EXTANT",
              "LOST",
              "FRAGMENTARY",
              "UNKNOWN"
            ]
          },
          "runtime_candidacy": {
            "type": "string",
            "enum": [
              "TEXT_CANDIDATE",
              "CATALOG_ONLY",
              "PENDING_REVIEW"
            ]
          },
          "attestations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "system",
                "status"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^PLSRC\\.[A-Z0-9_]+$"
                },
                "system": {
                  "type": "string",
                  "pattern": "^[A-Z0-9_]+$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "INCLUDED",
                    "EXPLICITLY_SPURIOUS",
                    "ASCRIBED",
                    "EDITORIALLY_INCLUDED"
                  ]
                },
                "position": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "review_status": {
            "type": "string",
            "enum": [
              "PROVISIONAL",
              "SOURCE_VERIFIED",
              "FROZEN"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_visibility": {
            "const": "CUSTODIAN_ONLY"
          },
          "epistolary_metadata": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "letter_number",
                  "traditional_number_roman",
                  "addressees",
                  "source_refs",
                  "addressee_review_status"
                ],
                "properties": {
                  "letter_number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 13
                  },
                  "traditional_number_roman": {
                    "type": "string",
                    "enum": [
                      "I",
                      "II",
                      "III",
                      "IV",
                      "V",
                      "VI",
                      "VII",
                      "VIII",
                      "IX",
                      "X",
                      "XI",
                      "XII",
                      "XIII"
                    ]
                  },
                  "addressees": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "entity_kind"
                      ],
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "entity_kind": {
                          "type": "string",
                          "enum": [
                            "PERSON",
                            "GROUP"
                          ]
                        },
                        "normalized_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "source_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^PLSRC\\.[A-Z0-9_]+$"
                    },
                    "uniqueItems": true
                  },
                  "addressee_review_status": {
                    "type": "string",
                    "enum": [
                      "SOURCE_VERIFIED",
                      "SOURCE_VERIFIED_WITH_VARIANT",
                      "PROVISIONAL"
                    ]
                  },
                  "variant_notes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "scope_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "THRASYLLAN_CANON",
                "THRASYLLAN_COLLECTION_MEMBER",
                "EXTRA_CANONICAL_EXTANT_ATTRIBUTION",
                "ANCIENT_EXPLICIT_SPURIA",
                "LOST_ATTRIBUTION",
                "ANTHOLOGICAL_ASCRIPTION",
                "EPIGRAMMATIC_ASCRIPTION"
              ]
            }
          },
          "anthology_metadata": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reference_scheme",
                  "reference",
                  "book",
                  "epigram",
                  "source_refs",
                  "attribution_review_status"
                ],
                "properties": {
                  "reference_scheme": {
                    "const": "GREEK_ANTHOLOGY"
                  },
                  "reference": {
                    "type": "string",
                    "pattern": "^AP [0-9]+\\.[0-9]+$"
                  },
                  "book": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "epigram": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "source_refs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^PLSRC\\.[A-Z0-9_]+$"
                    }
                  },
                  "attribution_review_status": {
                    "type": "string",
                    "enum": [
                      "SOURCE_VERIFIED",
                      "SOURCE_VERIFIED_WITH_COMPETING_ATTRIBUTION",
                      "PROVISIONAL"
                    ]
                  },
                  "competing_attribution": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "epigrammatic_metadata": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "historical_scope_id",
                  "logical_reference",
                  "witnesses",
                  "attribution_targets",
                  "profile_relation",
                  "source_refs",
                  "identity_review_status",
                  "pelucchi_2026_number"
                ],
                "properties": {
                  "historical_scope_id": {
                    "type": "string",
                    "pattern": "^TH\\.PLATO\\.EPSCOPE\\.[A-Z0-9_]+$"
                  },
                  "logical_reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "witnesses": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "scheme",
                        "reference",
                        "relation"
                      ],
                      "properties": {
                        "scheme": {
                          "type": "string",
                          "enum": [
                            "AP",
                            "APL",
                            "COUGNY",
                            "DIOGENES_LAERTIUS",
                            "ATHENAEUS",
                            "OTHER"
                          ]
                        },
                        "reference": {
                          "type": "string",
                          "minLength": 1
                        },
                        "relation": {
                          "type": "string",
                          "enum": [
                            "PRIMARY",
                            "PARALLEL",
                            "RELATED",
                            "VARIANT_WITNESS"
                          ]
                        }
                      }
                    }
                  },
                  "attribution_targets": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "PLATO_PHILOSOPHER",
                        "PLATO_UNSPECIFIED",
                        "PLATO_YOUNGER",
                        "PLATO_COMICUS",
                        "OTHER_AUTHOR",
                        "ANONYMOUS"
                      ]
                    }
                  },
                  "profile_relation": {
                    "type": "string",
                    "enum": [
                      "PHILOSOPHER_CANDIDATE",
                      "MIXED_REVIEW",
                      "HOMONYM_EXCLUDED"
                    ]
                  },
                  "source_refs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^PLSRC\\.[A-Z0-9_]+$"
                    }
                  },
                  "identity_review_status": {
                    "type": "string",
                    "enum": [
                      "SOURCE_VERIFIED",
                      "SOURCE_VERIFIED_WITH_COMPETING_ATTRIBUTION",
                      "SOURCE_VERIFIED_WITH_VARIANT",
                      "HOMONYM_EXCLUDED",
                      "PROVISIONAL"
                    ]
                  },
                  "pelucchi_2026_number": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 37
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
