{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fiodor78/project-plato/main/thinkers/plato/profile/authenticity-assertion.schema.json",
  "title": "Plato Profile Authenticity Assertion",
  "version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assertion_id",
    "catalog_id",
    "classification_system",
    "classification",
    "assessment_status",
    "evidence",
    "rationale",
    "assessed_at",
    "runtime_visibility"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "assertion_id": {
      "type": "string",
      "pattern": "^TH\\.PLATO\\.AUTH\\.[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "catalog_id": { "type": "string", "pattern": "^TH\\.PLATO\\.CAT\\.[A-Z0-9_]+$" },
    "classification_system": { "const": "PLATO_AUTHENTICITY_AD_V1" },
    "classification": { "type": "string", "enum": ["A", "B", "C", "D"] },
    "assessment_status": { "type": "string", "enum": ["PROVISIONAL", "REVIEWED", "FROZEN"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "evidence_type", "direction"],
        "properties": {
          "source_ref": { "type": "string", "minLength": 1 },
          "evidence_type": {
            "type": "string",
            "enum": [
              "ANCIENT_ATTESTATION",
              "ANCIENT_REJECTION",
              "MODERN_SCHOLARSHIP",
              "STYLOMETRY",
              "LINGUISTIC",
              "LITERARY_DEPENDENCE",
              "PHILOSOPHICAL_CONTENT",
              "EDITORIAL_HISTORY"
            ]
          },
          "direction": { "type": "string", "enum": ["SUPPORTS_AUTHENTICITY", "AGAINST_AUTHENTICITY", "CONTEXT_ONLY", "MIXED"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "assessed_at": { "type": "string", "format": "date-time" },
    "supersedes_assertion_id": { "type": ["string", "null"] },
    "runtime_visibility": { "const": "CUSTODIAN_ONLY" }
  }
}
